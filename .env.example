# 复制为本地 .env 或写入 GitHub Secrets；不要提交真实凭据。
# 本文件只包含变量名与占位符。

# 模型凭据（必填，在线审查使用；GitHub Actions 中配置为 Secret）
DEEPSEEK_API_KEY=

# 可选：模型与端点（默认值即可）
# CODE_REVIEW_MODEL=deepseek-v4-flash
# CODE_REVIEW_LLM_BASE_URL=https://api.deepseek.com

# 可选：PR 审查预算（JSON；仅维护者可修改可信配置）
# CODE_REVIEW_BUDGET={"max_files":50,"max_changed_lines":3000,"max_file_bytes":262144,"max_extra_context_bytes":2097152,"max_model_requests":40,"review_timeout_seconds":900,"model_retries_per_call":2,"artifact_retention_days":14,"max_rule_context_bytes":65536,"max_rule_page_bytes":4096}

# 可选：离线模式（只跑确定性检查，结果标为 incomplete）
# CODE_REVIEW_OFFLINE=0

# 可选：机器人评论账号（默认 github-actions[bot]）
# REVIEW_BOT_LOGIN=github-actions[bot]

# GitHub Actions 自动提供，无需手工设置：
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# GITHUB_RUN_ID=
